{
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "out",
    // Custom types
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": ["node", "mocha"],
    "strict": false,
    // Useful settings for debugging
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSourceMap": false,
    "inlineSources": true,
    // CommonJS interop
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    // Prevents cross-platform issues
    "forceConsistentCasingInFileNames": true,
    // Performance improvement
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}